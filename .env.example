# ============================================================
# 剧本杀每日热门榜（Top 10）· 数据源
# ------------------------------------------------------------
# 复制成 .env 后按注释填写。以 HS_ 开头的是本服务专用变量，
# SUPABASE_* / SILICONFLOW_* 可直接从 jbsttj-backend/.env 复用。
# ============================================================

# ---------------- 调度 ----------------
# 每天几点跑（24h），时区见 HS_TIMEZONE
HS_RUN_AT=09:00
HS_TIMEZONE=Asia/Shanghai
# 常驻模式下启动时是否立刻补跑一次当天榜单
HS_RUN_ON_START=true
# 榜单条数
HS_TOP_N=10
# 日志级别：DEBUG / INFO / WARNING / ERROR
HS_LOG_LEVEL=INFO
# 本地快照目录
HS_DATA_DIR=./data

# ---------------- 存储 ----------------
# auto = 先写 Supabase，失败降级本地；supabase = 只写 Supabase；local = 只写本地
HS_STORE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- 数据源：米圈（硬数据，推荐留着） ----------------
# 已抓包、带合法 sign 的 curl，每行一条（一个 pageNum 一条）。
# sign 绑定请求体，不能改任何字段；新增页数只能靠再抓一次包。
#
# ⚠️ 这两个 curl 文件含 usertoken+sign，被 .gitignore 排除（data/*.txt）——
# 后果是 `git clean -fdx` 之类的操作会把它们删掉，导致次日 09:00 定时任务
# 以「抓包文件不存在」失败（2026-09-11 实际发生过）。所以线上建议放到
# 仓库外的目录，用 HS_CREDS_DIR 指向它（compose 会只读挂到 /app/creds）：
#   HS_CREDS_DIR=/opt/jbs-hotsearch-creds
# 本地不设该变量时默认用 ./data。
HS_SOURCE_MIQUAN_ENABLED=true
# Docker 里由 compose 覆盖为 /app/creds/miquan_curls.txt（见 docker-compose.yml）
HS_SOURCE_MIQUAN_CURLS_FILE=./data/miquan_curls.txt
HS_SOURCE_MIQUAN_WEIGHT=1.0
# true = 剧本榜只作元数据（评分/标签/封面/人数），热度完全由拼场决定；
# false = 剧本榜「平台热度」也参与打分（历史累计人气计入榜单）。
HS_SOURCE_MIQUAN_AS_METADATA=true

# ---------------- 数据源：米圈拼场（去重后 = 有多少家店在开这个本） ----------------
# 拼场接口 /v10/group/homeScriptGroupList，返回逐条约本；按剧本聚合「唯一店家数」
# 作为热度（同店同本多场只算 1 家店，防止店家刷量）。sign 绑 pageNum，每页单独抓包、一行一条。
# 注意：拼场是「本地约本」口径（cityCode 决定城市），全国榜时只作辅助信号。
HS_SOURCE_MIQUAN_GROUP_ENABLED=false
HS_SOURCE_MIQUAN_GROUP_CURLS_FILE=./data/miquan_puzzle_curls.txt
# 权重：低于米圈推荐指数（1.0），让拼场作辅助而非主导
HS_SOURCE_MIQUAN_GROUP_WEIGHT=0.8
# 频次门槛：去重后 count = 唯一店家数，低于该值的本视为噪声不参与（如至少 2 家店在开）
HS_SOURCE_MIQUAN_GROUP_THRESHOLD=2
# 拼场时间窗：只统计「今天起 N 天内」开场的排期（含今天）。拼场接口返回的是未来
# 约一个月的排期，全量累加会让刷量店靠「连排一个月」虚高。N=3 = 今天+明+后天。
HS_SOURCE_MIQUAN_GROUP_TIME_WINDOW_DAYS=3
# 单店组局封顶：同一家店对同一本在时间窗内最多计 N 场组局，超过部分视为刷量不计入
#（防「单店连排多场」虚高）。0 = 不封顶。
HS_SOURCE_MIQUAN_GROUP_PER_SHOP_CAP=2

# ---------------- 数据源：搜索 + LLM 聚合（交叉验证用） ----------------
# 搜索 provider：none / bocha / tavily / serpapi
HS_SEARCH_PROVIDER=none
HS_SEARCH_API_KEY=
# LLM 用 OpenAI 兼容接口（SiliconFlow / DeepSeek / OpenAI 均可）
HS_LLM_BASE_URL=https://api.siliconflow.cn/v1
HS_LLM_API_KEY=
HS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HS_SOURCE_SEARCH_WEIGHT=0.8

# ---------------- 已解析过滤 ----------------
# 把「jbsttj-backend 已解析入库」的剧本从榜里剔除（判据：script_dm_documents
# 里 is_active=true 且 total_chunks>0）。需要上面 SUPABASE_* 凭据。
HS_FILTER_PARSED_ENABLED=true
# 抓取候选时按 top_n 的多少倍取（预留补位），过滤后仍能凑满 top_n
HS_FILTER_BUFFER_MULTIPLIER=3

# ---------------- 小红书素材（海报截图 + LLM 文案） ----------------
# 每天出榜后自动生成：data/social/YYYY-MM-DD.png（海报）、
# YYYY-MM-DD.txt（文案）、index.html（素材页，手机可存图/复制文案）。
HS_SOCIAL_ENABLED=true
# 海报尺寸（小红书竖图 3:4 保底；内容更多时截图器会自动加长，见 social.py）
HS_SOCIAL_POSTER_WIDTH=1080
HS_SOCIAL_POSTER_HEIGHT=1440
HS_SOCIAL_POSTER_SCALE=2
# 海报底部是否放「已解析·未入榜」区块（被 HS_FILTER 剔除、但热度够进榜的剧本）
HS_SOCIAL_SHOW_PARSED=true
# 该区块最多展示几本，超出折叠成「等 N 本」
HS_SOCIAL_PARSED_LIMIT=6
# 文案里点名提到已解析剧本的热度门槛：原热度 ≥ 榜首热度 × 该比例才写进文案
#（用意：25 分这种冷门的别占篇幅，但比榜首还热的一定要提）。0 = 不筛选
HS_SOCIAL_CAPTION_PARSED_RATIO=0.5
# 文案里最多点名几本已解析（按热度降序取前 N 本）
HS_SOCIAL_CAPTION_PARSED_MAX=2

# ---------------- 监听大盘（python -m jbs_hotsearch watch） ----------------
# 起一个只读的 Web 大盘，看「每天到底跑没跑成」：/ 页面、/api/status.json、/healthz
# 注意：script_hot_runs 的 RLS 只允许 service_role 读，所以大盘必须用 service_role key，
# 且不要把这个端口直接暴露到公网（页面里含错误信息等内部细节）。
HS_WATCH_HOST=127.0.0.1
HS_WATCH_PORT=8787
HS_WATCH_DAYS=30
# 过了 计划时间 + 宽限 还没有运行记录 = 判「今天没跑」
HS_WATCH_GRACE_MINUTES=60
HS_WATCH_REFRESH=60
HS_WATCH_CACHE_SECONDS=20
# 出问题时的告警出口：POST 一个 JSON（{service, today, alerts:[{date, level, message}]}）。
# 留空则不告警。同样的问题只在状态变化时推一次，不会每分钟刷屏。
HS_WATCH_WEBHOOK_URL=

# ---------------- 大盘上的其它任务 ----------------
# 共用同一个 Supabase，所以只要能读出对应表就能盯；不需要起 jbsttj-backend。
# SEO / GEO 产物探测的站点域名（前端构建期生成 sitemap.xml / llms.txt / feed.xml 等）
HS_WATCH_SITE_ORIGIN=https://www.jbs-ttj.store
HS_WATCH_DM_ENABLED=true
HS_WATCH_SEO_ENABLED=true
# 中间态任务卡住多少小时算僵尸（Celery worker 挂了会留下一堆）
HS_WATCH_STUCK_HOURS=2
# 探测单个产物的超时（5 个产物并发，总耗时≈这个值）
HS_WATCH_HTTP_TIMEOUT=6
