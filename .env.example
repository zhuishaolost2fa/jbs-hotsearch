# ============================================================
# 剧本杀每日热门榜（Top 10）· 数据源
# ------------------------------------------------------------
# 复制成 .env 后按注释填写。以 HS_ 开头的是本服务专用变量，
# SUPABASE_* / SILICONFLOW_* 可直接从 jbsttj-backend/.env 复用。
# ============================================================

# ---------------- 调度 ----------------
# 每天几点跑（24h），时区见 HS_TIMEZONE
HS_RUN_AT=09:00
HS_TIMEZONE=Asia/Shanghai
# 常驻模式下启动时是否立刻补跑一次当天榜单
HS_RUN_ON_START=true
# 榜单条数
HS_TOP_N=10
# 日志级别：DEBUG / INFO / WARNING / ERROR
HS_LOG_LEVEL=INFO
# 本地快照目录
HS_DATA_DIR=./data

# ---------------- 存储 ----------------
# auto = 先写 Supabase，失败降级本地；supabase = 只写 Supabase；local = 只写本地
HS_STORE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- 数据源：米圈（硬数据，推荐留着） ----------------
# 已抓包、带合法 sign 的 curl，每行一条（一个 pageNum 一条）。
# sign 绑定请求体，不能改任何字段；新增页数只能靠再抓一次包。
HS_SOURCE_MIQUAN_ENABLED=true
HS_SOURCE_MIQUAN_CURLS_FILE=./data/miquan_curls.txt
HS_SOURCE_MIQUAN_WEIGHT=1.0
# true = 剧本榜只作元数据（评分/标签/封面/人数），热度完全由拼场决定；
# false = 剧本榜「平台热度」也参与打分（历史累计人气计入榜单）。
HS_SOURCE_MIQUAN_AS_METADATA=true

# ---------------- 数据源：米圈拼场（去重后 = 有多少家店在开这个本） ----------------
# 拼场接口 /v10/group/homeScriptGroupList，返回逐条约本；按剧本聚合「唯一店家数」
# 作为热度（同店同本多场只算 1 家店，防止店家刷量）。sign 绑 pageNum，每页单独抓包、一行一条。
# 注意：拼场是「本地约本」口径（cityCode 决定城市），全国榜时只作辅助信号。
HS_SOURCE_MIQUAN_GROUP_ENABLED=false
HS_SOURCE_MIQUAN_GROUP_CURLS_FILE=./data/miquan_puzzle_curls.txt
# 权重：低于米圈推荐指数（1.0），让拼场作辅助而非主导
HS_SOURCE_MIQUAN_GROUP_WEIGHT=0.8
# 频次门槛：去重后 count = 唯一店家数，低于该值的本视为噪声不参与（如至少 2 家店在开）
HS_SOURCE_MIQUAN_GROUP_THRESHOLD=2
# 拼场时间窗：只统计「今天起 N 天内」开场的排期（含今天）。拼场接口返回的是未来
# 约一个月的排期，全量累加会让刷量店靠「连排一个月」虚高。N=3 = 今天+明+后天。
HS_SOURCE_MIQUAN_GROUP_TIME_WINDOW_DAYS=3
# 单店组局封顶：同一家店对同一本在时间窗内最多计 N 场组局，超过部分视为刷量不计入
#（防「单店连排多场」虚高）。0 = 不封顶。
HS_SOURCE_MIQUAN_GROUP_PER_SHOP_CAP=2

# ---------------- 数据源：搜索 + LLM 聚合（交叉验证用） ----------------
# 搜索 provider：none / bocha / tavily / serpapi
HS_SEARCH_PROVIDER=none
HS_SEARCH_API_KEY=
# LLM 用 OpenAI 兼容接口（SiliconFlow / DeepSeek / OpenAI 均可）
HS_LLM_BASE_URL=https://api.siliconflow.cn/v1
HS_LLM_API_KEY=
HS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HS_SOURCE_SEARCH_WEIGHT=0.8

# ---------------- 已解析过滤 ----------------
# 把「jbsttj-backend 已解析入库」的剧本从榜里剔除（判据：script_dm_documents
# 里 is_active=true 且 total_chunks>0）。需要上面 SUPABASE_* 凭据。
HS_FILTER_PARSED_ENABLED=true
# 抓取候选时按 top_n 的多少倍取（预留补位），过滤后仍能凑满 top_n
HS_FILTER_BUFFER_MULTIPLIER=3
