# ============================================================
# 剧本杀每日热门榜（Top 10）· 数据源
# ------------------------------------------------------------
# 复制成 .env 后按注释填写。以 HS_ 开头的是本服务专用变量，
# SUPABASE_* / SILICONFLOW_* 可直接从 jbsttj-backend/.env 复用。
# ============================================================

# ---------------- 调度 ----------------
# 每天几点跑（24h），时区见 HS_TIMEZONE
HS_RUN_AT=09:00
HS_TIMEZONE=Asia/Shanghai
# 常驻模式下启动时是否立刻补跑一次当天榜单
HS_RUN_ON_START=true
# 榜单条数
HS_TOP_N=10
# 日志级别：DEBUG / INFO / WARNING / ERROR
HS_LOG_LEVEL=INFO
# 本地快照目录
HS_DATA_DIR=./data

# ---------------- 存储 ----------------
# auto = 先写 Supabase，失败降级本地；supabase = 只写 Supabase；local = 只写本地
HS_STORE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- 数据源：米圈（硬数据，推荐留着） ----------------
# 已抓包、带合法 sign 的 curl，每行一条（一个 pageNum 一条）。
# sign 绑定请求体，不能改任何字段；新增页数只能靠再抓一次包。
HS_SOURCE_MIQUAN_ENABLED=true
HS_SOURCE_MIQUAN_CURLS_FILE=./data/miquan_curls.txt
HS_SOURCE_MIQUAN_WEIGHT=1.0

# ---------------- 数据源：搜索 + LLM 聚合（交叉验证用） ----------------
# 搜索 provider：none / bocha / tavily / serpapi
HS_SEARCH_PROVIDER=none
HS_SEARCH_API_KEY=
# LLM 用 OpenAI 兼容接口（SiliconFlow / DeepSeek / OpenAI 均可）
HS_LLM_BASE_URL=https://api.siliconflow.cn/v1
HS_LLM_API_KEY=
HS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HS_SOURCE_SEARCH_WEIGHT=0.8

# ---------------- 已解析过滤 ----------------
# 把「jbsttj-backend 已解析入库」的剧本从榜里剔除（判据：script_dm_documents
# 里 is_active=true 且 total_chunks>0）。需要上面 SUPABASE_* 凭据。
HS_FILTER_PARSED_ENABLED=true
# 抓取候选时按 top_n 的多少倍取（预留补位），过滤后仍能凑满 top_n
HS_FILTER_BUFFER_MULTIPLIER=3
